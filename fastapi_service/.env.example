# FastAPI ML Service Configuration
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# Model Paths (relative to project root or absolute)
FACENET_MODEL_PATH=../legacy/facenet_keras.h5
LIVENESS_MODEL_PATH=../legacy/liveness_model.h5

# Biometric Experimental Thresholds (Subject to research tuning)
LIVENESS_THRESHOLD=0.50
FACE_DISTANCE_THRESHOLD=1.00
FACE_COSINE_SIMILARITY_THRESHOLD=0.40

# Security & Payload Constraints
MAX_PAYLOAD_SIZE_MB=10
MIN_IMAGE_DIMENSION=64
MAX_IMAGE_DIMENSION=4096
